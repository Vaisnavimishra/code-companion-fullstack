# Copy this file to .env and fill in what you need.
# Every value is optional — the app runs fully on static analysis with
# no configuration at all.

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# --- Optional LLM-powered review agent ---
# Leave LLM_PROVIDER empty to disable the AI agent entirely (recommended
# unless you have a key). Static analysis remains fully functional either
# way.
#
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-6
#
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20

# --- Analysis behaviour ---
MAX_CODE_LENGTH=100000
EXTERNAL_TOOLS_TIMEOUT=8
