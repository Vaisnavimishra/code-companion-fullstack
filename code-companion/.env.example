# Optional. If unset, the frontend calls a relative "/api" path, which
# works out of the box in dev (via the Vite proxy in vite.config.ts,
# pointed at BACKEND_URL / http://localhost:8000) and in production behind
# a reverse proxy that forwards /api to the backend.
#
# Set this only if the frontend and backend are deployed on different
# origins (e.g. frontend on Vercel, backend on Render):
# VITE_API_URL=https://your-backend.example.com/api
VITE_API_URL=
